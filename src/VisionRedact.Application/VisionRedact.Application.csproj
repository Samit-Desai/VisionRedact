<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Use cases, pipelines and the ports (interfaces) infrastructure implements.
    Allowed dependencies: Domain + Microsoft.Extensions.Logging.Abstractions.
    Forbidden: Emgu CV, OpenCV, ONNX Runtime, WPF, Prism, Dispatcher, WriteableBitmap.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VisionRedact.Application</RootNamespace>
    <!-- OwnedVideoFrame exposes native pixel memory as ReadOnlySpan<byte>. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisionRedact.Domain\VisionRedact.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VisionRedact.Application.Tests" />
  </ItemGroup>
</Project>
