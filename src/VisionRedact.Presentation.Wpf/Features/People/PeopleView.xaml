<UserControl x:Class="VisionRedact.Presentation.Wpf.Features.People.PeopleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:people="clr-namespace:VisionRedact.Presentation.Wpf.Features.People"
             xmlns:behaviors="clr-namespace:VisionRedact.Presentation.Wpf.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=people:PeopleViewModel}"
             d:DesignWidth="380" d:DesignHeight="800"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- only while focus is in this tab. F2 = rename the selected person -->
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- trick: a ContextMenu is outside the visual tree, so the row's Tag carries the tab's view model to it -->
        <ContextMenu x:Key="PersonMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Rename" InputGestureText="F2" Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Confirm these tracks are one person" Command="{Binding PlacementTarget.Tag.ConfirmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Redact all" Command="{Binding PlacementTarget.Tag.RedactAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Keep visible in export" Command="{Binding PlacementTarget.Tag.KeepVisibleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Go to first appearance" Command="{Binding PlacementTarget.Tag.GoToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <ContextMenu x:Key="TrackMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Not this person (move to a new person)" Command="{Binding PlacementTarget.Tag.MoveToNewPersonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Go to track" Command="{Binding PlacementTarget.Tag.GoToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PEOPLE" Style="{StaticResource Text.SectionHeader}" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Text="Groups face tracks that show the same person, so you can name, redact or keep a whole person at once. Double-click or F2 to rename; right-click for more." />
            <CheckBox Margin="0,8,0,0" IsChecked="{Binding Consent}"
                      Content="Allow face grouping (biometric, kept in memory only)"
                      ToolTip="Face fingerprints are computed in memory for grouping and never saved to the project file." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Primary}" Content="Identify people" Command="{Binding IdentifyCommand}" />
                <Button Style="{StaticResource Button.Default}" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelIdentifyCommand}"
                        Visibility="{Binding IsIdentifying, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Default}" Margin="8,0,0,0" Content="Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" />
                <Button Style="{StaticResource Button.Default}" Margin="4,0,0,0" Content="Redo" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" />
            </StackPanel>
            <TextBlock Margin="0,6,0,8" Text="{Binding Status}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- rows are reused by person id on refresh, so a picture or an edit in progress survives it -->
        <ListBox Grid.Row="1" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="People">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type people:PersonItemViewModel}">
                    <Grid Margin="0,3" Background="Transparent" ContextMenu="{StaticResource PersonMenu}"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Brush.SurfaceRaised}" ClipToBounds="True">
                            <Border.Clip>
                                <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                            </Border.Clip>
                            <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                                         behaviors:InlineEdit.IsEditing="{Binding IsEditing}"
                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}">
                                <Run Text="{Binding Summary, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Redaction, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="check: some tracks are only suggested" Foreground="{StaticResource Brush.Warning}" FontSize="11"
                                       Visibility="{Binding NeedsCheck, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,8,0,4" Visibility="{Binding HasSelectedPerson, Converter={StaticResource BoolToVisibility}}">
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />
            <TextBlock Text="{Binding SelectedPerson.Name, StringFormat=TRACKS OF {0}}" Style="{StaticResource Text.SectionHeader}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Merge into" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding People}" SelectedItem="{Binding MergeTarget}" DisplayMemberPath="Name" />
                <Button Grid.Column="2" Style="{StaticResource Button.Default}" Margin="8,0,0,0" Content="Merge" Command="{Binding MergeCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Default}" Content="Confirm" Command="{Binding ConfirmCommand}" CommandParameter="{Binding SelectedPerson}" />
                <Button Style="{StaticResource Button.Default}" Margin="8,0,0,0" Content="Redact all" Command="{Binding RedactAllCommand}" CommandParameter="{Binding SelectedPerson}" />
                <Button Style="{StaticResource Button.Default}" Margin="8,0,0,0" Content="Keep visible" Command="{Binding KeepVisibleCommand}" CommandParameter="{Binding SelectedPerson}" />
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="3" ItemsSource="{Binding Tracks}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="Tracks of the selected person">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type people:TrackItemViewModel}">
                    <Grid Margin="0,2" Background="Transparent" ContextMenu="{StaticResource TrackMenu}"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="4" Background="{StaticResource Brush.SurfaceRaised}">
                            <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource Text.Caption}">
                                <Run Text="{Binding Range, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Source, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
