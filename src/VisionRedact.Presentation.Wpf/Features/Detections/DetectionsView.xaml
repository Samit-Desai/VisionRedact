<UserControl x:Class="VisionRedact.Presentation.Wpf.Features.Detections.DetectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:det="clr-namespace:VisionRedact.Presentation.Wpf.Features.Detections"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=det:DetectionsViewModel}"
             d:DesignWidth="380" d:DesignHeight="800"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- kept shallow, every element here is repeated per realized row -->
        <DataTemplate x:Key="DetectionRow" DataType="{x:Type det:DetectionItemViewModel}">
            <Grid Margin="0,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsRedacted}" ToolTip="Redact (uncheck = false positive)" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Caption}">
                        <Run Text="{Binding Timecode, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Status, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Transport}" Width="28" Height="26" Content="&#xE8AD;" ToolTip="Go to frame"
                            AutomationProperties.Name="Go to detection"
                            Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource Button.Transport}" Width="28" Height="26" Content="&#xE74D;" ToolTip="Delete detection"
                            AutomationProperties.Name="Delete detection"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="16,12">
        <!-- several models can run together (e.g. faces + persons), each on every scanned frame -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Transport}" Width="28" Height="24" Content="&#xE72C;"
                        ToolTip="Re-scan the models folder" Command="{Binding RefreshModelsCommand}" AutomationProperties.Name="Refresh models" />
                <TextBlock Text="MODELS" Style="{StaticResource Text.SectionHeader}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Preferences.Models}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type det:ModelOption}">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" Margin="0,0,0,6" ToolTip="{Binding Details}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="RUN ON" Style="{StaticResource Text.SectionHeader}" Margin="0,8,0,4" />
            <ComboBox ItemsSource="{Binding Preferences.Targets}" SelectedItem="{Binding Preferences.Target}"
                      ToolTip="CPU, or a GPU through DirectML (DirectX 12). Falls back to CPU if the GPU cannot run the model."
                      AutomationProperties.Name="Inference device" />

            <TextBlock Text="SAMPLING" Style="{StaticResource Text.SectionHeader}" Margin="0,8,0,4" />
            <ComboBox ItemsSource="{Binding Preferences.SamplingOptions}" SelectedItem="{Binding Preferences.Sampling}" />

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Style="{StaticResource Button.Default}" Margin="0,0,4,0" Command="{Binding DetectCurrentFrameCommand}" Content="Detect this frame" />
                <Button Style="{StaticResource Button.Primary}" Margin="4,0,0,0" Command="{Binding AnalyzeCommand}" Content="Analyze video" />
            </UniformGrid>

            <Grid Margin="0,10,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"
                             Foreground="{StaticResource Brush.Accent}" Background="{StaticResource Brush.SurfaceRaised}" BorderThickness="0" />
                <Button Grid.Column="1" Style="{StaticResource Button.Default}" Margin="8,0,0,0" Padding="10,3" Content="Cancel" Command="{Binding CancelCommand}" />
            </Grid>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Statistics}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />

            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,8" />
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" Width="110" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                <TextBlock Text="REVIEW" Style="{StaticResource Text.SectionHeader}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
            <WrapPanel Margin="0,6,0,6">
                <Button Style="{StaticResource Button.Default}" Padding="10,3" Margin="0,0,6,4" Content="Approve all pending" Command="{Binding ApproveAllPendingCommand}" />
                <Button Style="{StaticResource Button.Default}" Padding="10,3" Margin="0,0,6,4" Content="Approve track" Command="{Binding ApproveTrackCommand}" ToolTip="Approve every detection in the selected detection's track" />
                <Button Style="{StaticResource Button.Default}" Padding="10,3" Margin="0,0,0,4" Content="Reject track" Command="{Binding RejectTrackCommand}" ToolTip="Mark the whole track as a false positive" />
            </WrapPanel>
        </StackPanel>

        <!--
            virtualized: only the rows on screen get containers, recycled while scrolling.
            w/o it a long scan = one visual tree per detection. ScrollUnit=Item stays cheap however long the list
        -->
        <ListBox ItemsSource="{Binding ItemsView}" 
                 SelectedItem="{Binding SelectedItem}"
                 ItemTemplate="{StaticResource DetectionRow}"
                 HorizontalContentAlignment="Stretch"
                 Background="Transparent" BorderThickness="0"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Detections">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DockPanel>
</UserControl>
